datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  username        String?         @unique
  password        String
  name            String?
  avatar          String?
  bio             String?
  status          String          @default("ONLINE")
  globalCoins     Int             @default(0)
  zenGarden       Json?
  createdAt       DateTime        @default(now())
  memberships     ProjectMember[]
  invitations     Invitation[]    @relation("InvitedUser")
  sentInvitations Invitation[]    @relation("InvitationSender")
  notes           Note[]
  diaryItems      DiaryItem[]
  passwordResetOtps PasswordResetOtp[]
  createdRewards  Reward[]        @relation("RewardCreator")
  redemptions     Redemption[]
  notifications   Notification[]
  createdCassettes Cassette[]     @relation("CassetteCreator")
  pet             UserPet?
  coffeeBrews     CoffeeBrew[]
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  type        String          @default("WORK")
  allowMemberPrivateItems Boolean @default(false)
  coverImage  String?
  coinName    String          @default("Project Coin")
  coinSymbol  String          @default("🪙")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  boards      Board[]
  invitations Invitation[]
  notes       Note[]
  diaryItems  DiaryItem[]
  rewards     Reward[]
  cassettes   Cassette[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      String   @default("MEMBER")
  coins     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  projectId String
  token     String   @unique
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy String
  inviter   User     @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  user      User?    @relation("InvitedUser", fields: [email], references: [email])

  @@index([projectId])
  @@index([email])
}

model Board {
  id        String   @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   Column[]

  @@index([projectId])
}

model Column {
  id        String   @id @default(uuid())
  name      String
  position  Int
  boardId   String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId, position])
}

model Card {
  id            String    @id @default(uuid())
  title         String
  description   String?
  position      Int
  status        String    @default("TODO")
  color         String    @default("DEFAULT")
  checklist     Json?
  dueDate       DateTime?
  dueDateAllDay Boolean   @default(false)
  priority      String    @default("MEDIUM")
  isStarred     Boolean   @default(false)
  rewardCoins   Int       @default(0)
  privateCoins  Json?
  stickers      Json?
  columnId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  column        Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, position])
  @@index([dueDate])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  color     String   @default("DEFAULT")
  isStarred Boolean  @default(false)
  isHidden  Boolean  @default(false)
  dueDate   DateTime?
  dueDateAllDay Boolean @default(false)
  projectId String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
  @@index([projectId, dueDate])
  @@index([projectId, isHidden])
  @@index([authorId])
}

model DiaryItem {
  id           String   @id @default(uuid())
  title        String
  description  String?
  color        String   @default("DEFAULT")
  intervalDays Int
  startDate    DateTime
  isHidden     Boolean  @default(false)
  projectId    String
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, startDate])
  @@index([projectId, isHidden])
  @@index([authorId])
}

model PasswordResetOtp {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([userId])
}

model Reward {
  id            String       @id @default(uuid())
  name          String
  description   String?
  image         String?
  price         Int
  hasQuantity   Boolean      @default(false)
  quantity      Int?
  duration      String?      // e.g. cooldown duration
  projectId     String?      // null = Global Reward
  creatorId     String
  createdAt     DateTime     @default(now())
  creator       User         @relation("RewardCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  redemptions   Redemption[]

  @@index([projectId])
  @@index([creatorId])
}

model Redemption {
  id              String   @id @default(uuid())
  userId          String
  rewardId        String
  projectId       String?
  cost            Int
  quantity        Int      @default(1)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward          Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  type      String   // e.g. REDEMPTION_PENDING, REDEMPTION_STATUS
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Cassette {
  id          String   @id @default(uuid())
  name        String
  description String?
  tapeColor   String   @default("DEFAULT")
  tracks      Json     // e.g. [{ "title": "Track 1", "url": "..." }]
  projectId   String?  // null = Global/Private Cassette
  creatorId   String
  createdAt   DateTime @default(now())
  creator     User     @relation("CassetteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([creatorId])
}

model UserPet {
  id           String    @id @default(uuid())
  userId       String    @unique
  name         String    @default("Lofi Cat")
  type         String    @default("CAT") // CAT, DOG
  blanketColor String    @default("indigo")
  level        Int       @default(1)
  lastFedAt    DateTime?
  coinsSpent   Int       @default(0)
  toysUnlocked Json?     // List of cosmetics/toys e.g. ["PILLOW", "BALL"]
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoffeeBrew {
  id             String   @id @default(uuid())
  userId         String
  brewType       String   // ESPRESSO, MATCHA, CHAMOMILE
  diaryNotes     String
  buffExpiresAt  DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
